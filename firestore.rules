rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() { return request.auth != null; }
    function isAdmin() { 
      // Bootstrap mode: allow first user to be admin, or check admins collection
      return isSignedIn() && (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) || getAfter(/databases/$(database)/documents/admins/$(request.auth.uid)) != null); 
    }

    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isValidLead(data) {
      return data.keys().hasAll(['name', 'phone', 'status', 'createdAt']) &&
        data.name is string && data.name.size() <= 100 &&
        data.phone is string && data.phone.size() <= 20 &&
        data.status is string && data.status.size() <= 50 &&
        data.createdAt is string; // using timestamp string for simplicity
    }

    match /admins/{adminId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == adminId);
      // Allow creation of first admin to bootstrap via UI, then locked down
      // For simplicity in this env, we allow authenticated users to become admin 
      // if they create their document, but in production this should be manual.
      allow create: if isSignedIn() && request.auth.uid == adminId;
      allow update, delete: if isAdmin();
    }

    match /projects/{projectId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /gallery/{galleryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /blogs/{blogId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /leads/{leadId} {
      // Anyone can create a lead
      allow create: if isValidId(leadId) && isValidLead(incoming());
      // Only admins can read, update, delete
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
    }
  }
}
