{
  "entities": {
    "admin": {
      "title": "Admin",
      "description": "Administrator with access to admin panel",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["email", "createdAt"]
    },
    "project": {
      "title": "Project",
      "description": "Real Estate Project",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "location": { "type": "string" },
        "price": { "type": "string" },
        "description": { "type": "string" },
        "amenities": { "type": "array" },
        "reraNumber": { "type": "string" },
        "status": { "type": "string" },
        "images": { "type": "array" },
        "videos": { "type": "array" },
        "brochure": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["title", "location", "createdAt"]
    },
    "lead": {
      "title": "Lead",
      "description": "Customer Inquiry Lead",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "projectInterested": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "phone", "status", "createdAt"]
    },
    "blog": {
      "title": "Blog",
      "description": "Blog Post",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "content": { "type": "string" },
        "image": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["title", "content", "createdAt"]
    },
    "galleryItem": {
       "title": "Gallery Item",
       "description": "Image or Video for Gallery",
       "type": "object",
       "properties": {
         "type": { "type": "string" },
         "url": { "type": "string" },
         "createdAt": { "type": "string" }
       },
       "required": ["url", "type", "createdAt"]
    }
  },
  "firestore": {
    "/admins/{adminId}": { "schema": "admin", "description": "Admin Users" },
    "/projects/{projectId}": { "schema": "project", "description": "Projects listing" },
    "/leads/{leadId}": { "schema": "lead", "description": "Inquiries" },
    "/blogs/{blogId}": { "schema": "blog", "description": "Blog Posts" },
    "/gallery/{galleryId}": { "schema": "galleryItem", "description": "Gallery Media" }
  }
}
